{
  "name": "svg-transform-core-workspace",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:compile": "pnpm -r run build:compile",
    "check": "pnpm run check:release && pnpm run lint && pnpm run typecheck && pnpm run build:compile && pnpm run test:run && pnpm run check:package:built",
    "check:package": "pnpm -C packages/client run pack:check",
    "check:package:built": "pnpm -C packages/client run pack:check:built",
    "check:release": "node scripts/check-release.mjs",
    "clean": "pnpm -r --if-present run clean",
    "dev": "pnpm -C apps/server dev",
    "docker:health": "bash scripts/docker-core.sh health",
    "docker:logs": "bash scripts/docker-core.sh logs",
    "docker:recreate": "bash scripts/docker-core.sh recreate",
    "docker:start": "bash scripts/docker-core.sh start",
    "docker:status": "bash scripts/docker-core.sh status",
    "docker:stop": "bash scripts/docker-core.sh stop",
    "lint": "eslint . --max-warnings=0",
    "lint:types": "pnpm run typecheck",
    "start": "pnpm -C apps/server start",
    "test": "pnpm -r --if-present run test",
    "test:run": "pnpm -r run test:run",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=10.11.0 <11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.6",
      "nanoid@3": "3.3.18",
      "postcss@8.5": "8.5.26",
      "proxy-addr@2": "2.0.8",
      "source-map-js@1": "1.2.2"
    }
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "publint": "0.3.25",
    "typescript-eslint": "8.71.2"
  }
}
