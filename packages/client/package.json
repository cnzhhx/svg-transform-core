{
  "name": "@svg-transform/core-client",
  "version": "0.2.2",
  "description": "HTTP client SDK for the svg-transform-core service.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnzhhx/svg-transform-core.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/cnzhhx/svg-transform-core#readme",
  "bugs": {
    "url": "https://github.com/cnzhhx/svg-transform-core/issues"
  },
  "keywords": [
    "svg",
    "transform",
    "html",
    "vue",
    "react",
    "client"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:compile",
    "build:compile": "pnpm run clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "lint:types": "pnpm run typecheck",
    "pack:check": "pnpm run build && pnpm run pack:check:built",
    "pack:check:built": "node ../../scripts/check-package.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test",
    "test": "pnpm run build && pnpm run test:run",
    "test:run": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
