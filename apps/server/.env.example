# Core runtime
PORT=4310
WORKSPACE=workspace
MODEL_PROVIDER_CONFIG=config/model-provider.json
OPENCODE_CLI_PATH=opencode
FLUTTER_BIN=flutter

# Job and module concurrency
MAX_CONCURRENT_AGENTS=2
MAX_PARALLEL_MODULE_AGENTS=5
SEMANTIC_VISION_CONCURRENCY=3
MODULE_AGENT_TIMEOUT_MS=3600000
MODULE_AGENT_COORDINATOR_ENABLED=true
MODULE_AGENT_COORDINATOR_NODE_THRESHOLD=50
MODULE_AGENT_COORDINATOR_JSON_BYTES=35840

# Browser and rendering
# CHROMIUM_PATH=/absolute/path/to/chromium
# CHROME_PATH=/absolute/path/to/chrome
# BROWSER_PATH=/absolute/path/to/a/chromium-compatible-browser
CDP_OPERATION_CONCURRENCY=1
CDP_READY_TIMEOUT_MS=60000
CDP_SEND_TIMEOUT_MS=120000
BROWSER_POOL_DISABLED=false
BROWSER_POOL_IDLE_MS=1000
STATIC_SERVER_POOL_DISABLED=false
STATIC_SERVER_POOL_IDLE_MS=1000

# Verification
DIFF_RATIO_THRESHOLD=0.05
MODULE_DIFF_RATIO_THRESHOLD=0.05
PNG_RASTER_SCALE_MULTIPLIER=2

# Model reasoning
DEFAULT_AGENT_REASONING_EFFORT=high
AGENT_UNIT_REASONING_EFFORT=high
SUPPORT_AGENT_REASONING_EFFORT=high
VISION_TEXT_TIMEOUT_MS=300000
MODEL_PLANNER_TURN_TIMEOUT_MS=600000

# Session persistence and archive limits
SESSION_LOCAL_STORAGE_ENABLED=false
SESSION_AGENT_MESSAGE_SAMPLE_CHARS=100
SESSION_AGENT_REASONING_MESSAGE_CHARS=4000
ARCHIVE_COMMAND_OUTPUT_MAX_CHARS=5000
WORKFLOW_ARCHIVE_FULL_EVERY_N=5
WORKFLOW_ARCHIVE_TEXT_MAX_CHARS=12000

# Log and telemetry retention
SESSION_LOG_MAX_CHARS=12000
SESSION_LOG_MAX_ENTRIES=500
SESSION_AGENT_EVENT_OUTPUT_MAX_CHARS=100
SESSION_AGENT_REASONING_EVENT_MAX_CHARS=4000
SESSION_AGENT_STDOUT_LOG_CHARS=100
SESSION_AGENT_STDOUT_LOG_LINE_CHARS=100
SESSION_AGENT_STDOUT_LOG_LINES=20
SESSION_EVENT_COMMAND_CHARS=100
SESSION_EVENT_COMMAND_OUTPUT_CHARS=100
SESSION_EVENT_METRIC_CHUNK_GAPS=20
SESSION_EVENT_METRIC_THINK_SAMPLES=0
SESSION_EVENT_REASONING_CHARS=4000
SESSION_EVENT_TOOL_TEXT_CHARS=100
SESSION_MODEL_TELEMETRY_RECORDS=200
