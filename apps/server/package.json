{
  "name": "@svg-transform/server",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:compile",
    "build:compile": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/build-mcp.mjs",
    "build:mcp": "pnpm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "dev": "NODE_ENV=development tsx src/server.ts",
    "lint:types": "pnpm run typecheck",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "pnpm run test:run",
    "test:coverage": "tsx --test --experimental-test-coverage \"tests/unit/**/*.test.ts\"",
    "test:run": "tsx --test \"tests/unit/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "pnpm": ">=10.11.0 <11"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-vue": "6.0.7",
    "archiver": "7.0.1",
    "express": "5.2.1",
    "multer": "1.4.5-lts.2",
    "nanoid": "5.1.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0",
    "tsx": "4.22.4",
    "vite": "8.2.2",
    "vue": "3.5.42",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.1",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.1",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
}
